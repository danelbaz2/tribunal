# The three settings. Copy to `.env` — which is gitignored and never committed.

# OpenRouter. The pool draws from the free tier; a paid model changes what is
# being measured, so do not point this at one without deciding to.
OPENROUTER_API_KEY=sk-or-v1-...

# PostgreSQL, local or Supabase-hosted. The driver must be asyncpg.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tribunal

# Required. A hand-picked, static list of at least seven free model
# identifiers, best first. Not checked against OpenRouter at startup -- if one
# has left the free tier, the run that draws it fails and says which slot and
# model failed. Update this list by hand when that happens.
MODEL_POOL=["vendor/model-a:free","vendor/model-b:free","vendor/model-c:free","vendor/model-d:free","vendor/model-e:free","vendor/model-f:free","vendor/model-g:free"]

# Optional. Calls in flight at once, inside a stage. Four is the default,
# letting every advocate (and every judge) start together -- but the free
# tier is documented to answer 429 to a burst of exactly four, so lower this
# if a real run starts seeing rate limits it didn't at two or three.
# MAX_CONCURRENT_CALLS=4

# Optional. How hard a model may think before it answers. Measured: 65% of
# every output token was hidden reasoning, which was the main reason a call
# took 70-126s and the reason some came back empty. "low" cut it to 1% and the
# call to 44s, with *more* visible text.
#
# Do not set "none": gpt-oss-20b answers 400 "Reasoning is mandatory for this
# endpoint and cannot be disabled", as do `enabled: false` and `max_tokens: 0`.
# "minimal" is the only other value confirmed to work.
# REASONING_EFFORT=low
