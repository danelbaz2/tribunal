# The two secrets. Copy to `.env` — which is gitignored and never committed.

# OpenRouter. The pool draws from the free tier; a paid model changes what the
# comparison measures, so do not point this at one without deciding to.
OPENROUTER_API_KEY=sk-or-v1-...

# PostgreSQL, local or Supabase-hosted. The driver must be asyncpg.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tribunal

# Optional. The pool is discovered from OpenRouter's live free tier at startup;
# set this to pin it instead -- to reproduce an old run, or to hold the bench
# still across a comparison. A pinned pool is checked at startup and fails
# loudly if a member has left the tier.
# MODEL_POOL=["vendor/model-a:free","vendor/model-b:free"]
